<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All posts</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Quora posts</h1>

   <%  for(posts of posts){ %>
    <div class="post">

    <h3 class="user"> @<%= posts.username %></h3>
    <p class="content"><%= posts.content %></p>
     <a href="http://localhost:8080/posts/<%= posts.id %>"> View Post</a>
<br>
<br>
<a href="http://localhost:8080/posts/<%= posts.id %>/edit"> Edit Post</a>
<br><br>
<form action="/posts/<%= posts.id %>?_method=DELETE" method="POST">
<button >Delete Post</button>
</form>
    </div>
   
<hr>
<% } %>
<br>
<a href="http://localhost:8080/posts/new"> Create New Post</a>
<br><br>
<br><br>
<hr>
</body>
</html>

