<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #1f1c2c, #928dab);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            color: white;
        }

        .card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(15px);
            padding: 40px;
            border-radius: 20px;
            width: 500px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        h1 {
            text-align: center;
            margin-bottom: 20px;
        }

        .info {
            margin-bottom: 15px;
            font-size: 0.9rem;
            opacity: 0.8;
        }

        textarea {
            width: 100%;
            height: 120px;
            border-radius: 10px;
            border: none;
            padding: 10px;
            font-size: 0.9rem;
            resize: none;
        }

        .actions {
            margin-top: 20px;
            display: flex;
            gap: 10px;
        }

        .btn {
            padding: 8px 15px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-size: 0.9rem;
            text-decoration: none;
        }

        .update {
            background: #4cc9f0;
            color: white;
        }

        .back {
            background: #f9c74f;
            color: black;
        }

        .btn:hover {
            opacity: 0.85;
        }
    </style>
</head>
<body>

    <div class="card">
        <h1>Edit Post</h1>

        <p class="info">Post ID: <%= post.id %></p>
        <p class="info">Username: @<%= post.username %></p>

        <form method="POST" action="/posts/<%= post.id %>?_method=PATCH"> 
            <textarea name="content"><%= post.content %></textarea>

            <div class="actions">
                <button class="btn update">Update</button>
                <a class="btn back" href="/posts">Cancel</a>
            </div>
        </form>
    </div>

</body>
</html>